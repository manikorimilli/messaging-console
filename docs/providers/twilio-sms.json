{
  "id": "TWILIO_SMS",
  "display-name": "Twilio SMS",
  "channel": "SMS",
  "enabled": true,
  "variables": {
    "account-sid": "",
    "auth-token": "",
    "from": ""
  },
  "system-variables": {
    "uaap.to": "",
    "uaap.text": ""
  },
  "request": {
    "method": "POST",
    "url": "https://api.twilio.com/2010-04-01/Accounts/{{account-sid}}/Messages.json",
    "auth": {
      "type": "basic",
      "username": "{{account-sid}}",
      "password": "{{auth-token}}"
    },
    "body": {
      "format": "form",
      "fields": {
        "To": "{{uaap.to}}",
        "From": "{{from}}",
        "Body": "{{uaap.text}}"
      }
    }
  },
  "response": {
    "success": { "http-status": ["2xx"] },
    "id-path": "$.sid",
    "status-path": "$.status",
    "error": { "code-path": "$.code", "message-path": "$.message" },
    "retry": { "http-status": ["429", "5xx"] }
  }
}
