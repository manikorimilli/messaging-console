{
  "id": "TWILIO_WHATSAPP_DELIVERY_UPDATE",
  "display-name": "Twilio WhatsApp - Delivery Update",
  "channel": "WHATSAPP",
  "enabled": true,
  "variables": {
    "account-sid": "",
    "auth-token": "",
    "from": "+14155238886",
    "content-sid": "HXa9d0fd6215858003e64aae6f151ea1e7"
  },
  "request": {
    "method": "POST",
    "url": "https://api.twilio.com/2010-04-01/Accounts/{{account-sid}}/Messages.json",
    "auth": {
      "type": "basic",
      "username": "{{account-sid}}",
      "password": "{{auth-token}}"
    },
    "body": {
      "format": "form",
      "fields": {
        "To": "whatsapp:{{to}}",
        "From": "whatsapp:{{from}}",
        "ContentSid": "{{content-sid}}"
      }
    }
  },
  "response": {
    "success": { "http-status": ["2xx"] },
    "id-path": "$.sid",
    "status-path": "$.status",
    "error": { "code-path": "$.code", "message-path": "$.message" },
    "retry": { "http-status": ["429", "5xx"] }
  }
}
